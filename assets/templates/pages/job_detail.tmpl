{{define "job_detail"}}
{{ if .Error }}
<article>
    <header>
        <strong>Error</strong>
    </header>
    <p>{{ .Error }}</p>
</article>
{{ else }}
<main class="container">
    <nav>
        <ul>
            <li><a href="#" onclick="window.history.back()" class="secondary">&larr; Back to Results</a></li>
        </ul>
    </nav>

    <article>
        <header>
            <div class="grid">
                <div>
                    <h1>{{ .Job.Position }}</h1>
                    <p>{{ .Job.CompanyName }} • {{ .Job.Location }}</p>
                    <p>{{ .Job.PostingTime }} • {{ .Job.EmploymentType }}</p>
                    {{ if .Job.BasePay }}
                    <p><strong>Salary Range:</strong> {{ .Job.BasePay }}</p>
                    {{ end }}
                </div>
            </div>
        </header>

        <!-- Requirements Requirements Section -->
        {{ if .Requirements }}
        <section>
            <h2>Requirements</h2>
            <ul>
                {{ if .Requirements.MustHaveRequirements }}
                <li><strong>Must Have Requirements:</strong>
                    <ul>
                        {{ range .Requirements.MustHaveRequirements }}
                        <li>{{ . }}</li>
                        {{ end }}
                    </ul>
                </li>
                {{ end }}
                {{ if .Requirements.PreferredSkills }}
                <li><strong>Preferred Skills:</strong>
                    <ul>
                        {{ range .Requirements.PreferredSkills }}
                        <li>{{ . }}</li>
                        {{ end }}
                    </ul>
                </li>
                {{ end }}
                {{ if .Requirements.WorkLocation }}
                <li><strong>Work Location:</strong> {{ .Requirements.WorkLocation }}</li>
                {{ end }}
                {{ if .Requirements.CompanyCulture }}
                <li><strong>Company Culture:</strong> {{ .Requirements.CompanyCulture }}</li>
                {{ end }}
                {{ if .Requirements.AdditionalInfo }}
                <li><strong>Additional Information:</strong> {{ .Requirements.AdditionalInfo }}</li>
                {{ end }}
            </ul>
        </section>
        {{ end }}


        <section>
            <h2>Job Description</h2>
            <!-- Using white-space: pre-wrap to preserve formatting -->
            <div style="white-space: pre-wrap;">{{ .Description }}</div>
        </section>

        {{ if .Job.Recruiters }}
        <section>
            <h2>Recruiters</h2>
            {{ range .Job.Recruiters }}
            <div class="grid">
                <div style="width: 50px">
                    <img src="{{ .Photo }}" alt="{{ .Name }}" style="width: 100%; border-radius: 50%">
                </div>
                <div>
                    <p><strong>{{ .Name }}</strong><br>
                        {{ .Title }}</p>
                </div>
            </div>
            {{ end }}
        </section>
        {{ end }}

        <footer>
            <a href="{{ .Job.CompanyLinkedInID }}" target="_blank" role="button" class="secondary">View Company
                Profile</a>
            <a href="#" onclick="window.history.back()" class="secondary">Back to Results</a>
        </footer>
    </article>
</main>
{{ end }}
{{end}}

{{/* If this template is used as a full page, it will be rendered in the main element */}}
{{define "page:main"}}
{{template "job_detail" .}}
{{end}}