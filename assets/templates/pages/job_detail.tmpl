{{define "page:main"}}

<main class="container">
    <nav>
        <ul>
            <li><a href="/" class="secondary">&larr; Back to Search</a></li>
        </ul>
    </nav>

    <article>
        <header>
            <div class="grid">
                <div>
                    <h1>{{ .Job.Position }}</h1>
                    <p>{{ .Job.CompanyName }} • {{ .Job.Location }}</p>
                    <p>{{ .Job.PostingTime }} • {{ .Job.EmploymentType }}</p>
                    {{ if .Job.BasePay }}
                    <p><strong>Salary Range:</strong> {{ .Job.BasePay }}</p>
                    {{ end }}
                </div>
            </div>
        </header>

        <section>
            <h2>Job Description</h2>
            <!-- Using white-space: pre-wrap to preserve formatting -->
            <div style="white-space: pre-wrap;">{{ .Job.Description }}</div>
        </section>

        {{ if .Job.Recruiters }}
        <section>
            <h2>Recruiters</h2>
            {{ range .Job.Recruiters }}
            <div class="grid">
                <div style="width: 50px">
                    <img src="{{ .Photo }}" alt="{{ .Name }}" style="width: 100%; border-radius: 50%">
                </div>
                <div>
                    <p><strong>{{ .Name }}</strong><br>
                        {{ .Title }}</p>
                </div>
            </div>
            {{ end }}
        </section>
        {{ end }}

        <footer>
            <a href="{{ .Job.CompanyLinkedInID }}" target="_blank" role="button" class="secondary">View Company
                Profile</a>
            <a href="#" onclick="window.history.back()" class="secondary">Back to Results</a>
        </footer>
    </article>
</main>

{{end}}