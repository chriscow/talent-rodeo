{{define "page:call-status"}}
<main class="container"></main>
<h1>Call Status</h1>

<script>
    console.log("starting to watch for status updates");
    const es = new EventSource("/call/status/{{ .SessionID }}");
    es.onmessage = (event) => {
        console.log(`Received: ${event.data}`);
    };
</script>
</main>
{{end}}