{{ define "content" }}
<!-- pages/interview.tmpl -->
<article>
    <header>
        <h2>Initial Interview</h2>
        <p>Let's start your job search journey. I'll ask you some questions to understand your background and goals
            better.</p>
    </header>

    <div id="interview-container">
        <div id="status-message"></div>

        <div id="controls">
            <button id="startButton" class="primary" disabled>
                Start Interview
            </button>
            <button id="stopButton" class="secondary hidden">
                Stop Recording
            </button>
            <button id="sendButton" class="contrast hidden">
                Send Recording
            </button>
        </div>

        <div id="transcript" class="hidden">
            <h3>Conversation</h3>
            <div id="conversation-log"></div>
        </div>
    </div>
</article>
{{ end }}

{{ define "scripts" }}
<script>
    // OpenAI WebSocket wrapper class to manage the connection and message handling
    class OpenAIWebSocket {
        constructor() {
            this.ws = null;
            this.isConnected = false;
            this.messageQueue = [];
            this.eventHandlers = new Map();
            this.connect = this.connect.bind(this);
            this.reconnectAttempts = 0;
            this.maxReconnectAttempts = 5;
        }

        connect() {
            return new Promise((resolve, reject) => {
                try {
                    this.ws = new WebSocket(`ws://${window.location.host}/ws`);

                    this.ws.onopen = () => {
                        console.log('WebSocket connected');
                        this.isConnected = true;
                        this.reconnectAttempts = 0;
                        this.processMessageQueue();
                        resolve();
                    };

                    this.ws.onclose = () => {
                        console.log('WebSocket disconnected');
                        this.isConnected = false;
                        this.handleDisconnect();
                    };

                    this.ws.onerror = (error) => {
                        console.error('WebSocket error:', error);
                        reject(error);
                    };

                    this.ws.onmessage = (event) => {
                        try {
                            const serverEvent = JSON.parse(event.data);
                            this.handleServerEvent(serverEvent);
                        } catch (error) {
                            console.error('Error processing server message:', error);
                        }
                    };
                } catch (error) {
                    reject(error);
                }
            });
        }

        handleDisconnect() {
            if (this.reconnectAttempts < this.maxReconnectAttempts) {
                this.reconnectAttempts++;
                console.log(`Attempting to reconnect (${this.reconnectAttempts}/${this.maxReconnectAttempts})...`);
                setTimeout(() => this.connect(), 1000 * Math.pow(2, this.reconnectAttempts));
            } else {
                console.error('Max reconnection attempts reached');
            }
        }

        handleServerEvent(event) {
            const handlers = this.eventHandlers.get(event.type) || [];
            handlers.forEach(handler => {
                try {
                    handler(event);
                } catch (error) {
                    console.error('Error in event handler:', error);
                }
            });
        }

        on(eventType, handler) {
            if (!this.eventHandlers.has(eventType)) {
                this.eventHandlers.set(eventType, []);
            }
            this.eventHandlers.get(eventType).push(handler);
        }

        sendMessage(message) {
            if (this.isConnected) {
                try {
                    this.ws.send(JSON.stringify(message));
                } catch (error) {
                    console.error('Error sending message:', error);
                    this.messageQueue.push(message);
                }
            } else {
                this.messageQueue.push(message);
            }
        }

        processMessageQueue() {
            while (this.messageQueue.length > 0) {
                const message = this.messageQueue.shift();
                this.sendMessage(message);
            }
        }

        close() {
            if (this.ws) {
                this.ws.close();
            }
        }
    }

    // Audio recording state management
    let mediaRecorder;
    let audioChunks = [];
    let isRecording = false;
    let currentAudioBlob = null;
    const openai = new OpenAIWebSocket();

    // DOM elements
    const startButton = document.getElementById('startButton');
    const stopButton = document.getElementById('stopButton');
    const sendButton = document.getElementById('sendButton');
    const statusMessage = document.getElementById('status-message');
    const conversationLog = document.getElementById('conversation-log');
    const transcript = document.getElementById('transcript');

    // Initialize WebSocket connection
    async function initializeSession() {
        try {
            await openai.connect();
            startButton.disabled = false;

            // Configure the session for audio interaction
            openai.sendMessage({
                type: 'session.update',
                session: {
                    modalities: ['text', 'audio'],
                    voice: 'shimmer',
                    outputAudioFormat: 'pcm16',
                    inputAudioTranscription: {
                        model: 'whisper-1'
                    }
                }
            });
        } catch (error) {
            statusMessage.innerHTML = '<p class="error">Failed to connect to server. Please refresh the page.</p>';
        }
    }

    // Set up OpenAI event handlers
    openai.on('session.created', (event) => {
        console.log('Session created:', event);
    });

    openai.on('conversation.item.input.audio.transcription.completed', (event) => {
        const userMessage = document.createElement('p');
        userMessage.innerHTML = `<strong>You:</strong> ${event.transcript}`;
        conversationLog.appendChild(userMessage);
    });

    openai.on('response.text.done', (event) => {
        const aiMessage = document.createElement('p');
        aiMessage.innerHTML = `<strong>AI:</strong> ${event.text}`;
        conversationLog.appendChild(aiMessage);
        conversationLog.scrollTop = conversationLog.scrollHeight;

        statusMessage.innerHTML = '<p>Ready to record again...</p>';
        sendButton.classList.add('hidden');
        sendButton.disabled = false;
    });

    openai.on('error', (event) => {
        console.error('OpenAI error:', event);
        statusMessage.innerHTML = `<p class="error">Error: ${event.message}</p>`;
    });

    async function startRecording() {
        try {
            // Reset recording state
            audioChunks = [];
            currentAudioBlob = null;
            statusMessage.innerHTML = '';
            sendButton.classList.add('hidden');

            // Request audio access with specific constraints
            const stream = await navigator.mediaDevices.getUserMedia({
                audio: {
                    channelCount: 1,
                    sampleRate: 44100,
                    sampleSize: 16,
                    volume: 1.0,
                    echoCancellation: true,
                    noiseSuppression: true,
                    autoGainControl: true
                }
            });

            // Initialize MediaRecorder
            mediaRecorder = new MediaRecorder(stream, {
                mimeType: 'audio/webm;codecs=opus',
                audioBitsPerSecond: 128000
            });

            mediaRecorder.ondataavailable = (event) => {
                audioChunks.push(event.data);
            };

            mediaRecorder.onstop = async () => {
                createAudioPreview();
            };

            mediaRecorder.start();
            isRecording = true;
            startButton.classList.add('hidden');
            stopButton.classList.remove('hidden');
            statusMessage.innerHTML = '<p class="recording">Recording in progress...</p>';
            transcript.classList.remove('hidden');
        } catch (err) {
            console.error('Error accessing microphone:', err);
            statusMessage.innerHTML = '<p class="error">Error accessing microphone. Please ensure you have granted permission.</p>';
        }
    }

    function createAudioPreview() {
        currentAudioBlob = new Blob(audioChunks, { type: 'audio/wav' });
        const audioUrl = URL.createObjectURL(currentAudioBlob);

        // Create preview container
        const previewContainer = document.createElement('div');

        // Add debug information
        const fileSizeMB = (currentAudioBlob.size / (1024 * 1024)).toFixed(2);
        const debugInfo = document.createElement('div');
        debugInfo.innerHTML = `
            <p>Audio file size: ${fileSizeMB} MB</p>
            <p>MIME type: ${currentAudioBlob.type}</p>
            <p>Preview your recording:</p>
        `;

        // Add audio player
        const audioPreview = document.createElement('audio');
        audioPreview.src = audioUrl;
        audioPreview.controls = true;

        // Update UI
        statusMessage.innerHTML = '';
        previewContainer.appendChild(debugInfo);
        previewContainer.appendChild(audioPreview);
        statusMessage.appendChild(previewContainer);
        sendButton.classList.remove('hidden');
    }

    async function stopRecording() {
        if (mediaRecorder && isRecording) {
            mediaRecorder.stop();
            mediaRecorder.stream.getTracks().forEach(track => track.stop());
            isRecording = false;
            startButton.classList.remove('hidden');
            stopButton.classList.add('hidden');
        }
    }

    async function sendRecording() {
        if (!currentAudioBlob) {
            console.error('No audio recording available');
            return;
        }

        try {
            statusMessage.innerHTML = '<p>Converting and sending audio...</p>';
            sendButton.disabled = true;

            // Convert audio to proper format
            const convertedBlob = await convertAudio(currentAudioBlob);
            const base64Audio = await blobToBase64(convertedBlob);

            // Send audio to OpenAI
            openai.sendMessage({
                type: 'input.audio.buffer.append',
                audio: base64Audio
            });

            openai.sendMessage({
                type: 'input.audio.buffer.commit'
            });

            openai.sendMessage({
                type: 'response.create',
                response: {
                    modalities: ['text']
                }
            });
        } catch (err) {
            console.error('Error sending audio:', err);
            statusMessage.innerHTML = '<p class="error">Error processing audio. Please try again.</p>';
            sendButton.disabled = false;
        }
    }

    // Utility function to convert blob to base64
    async function blobToBase64(blob) {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onloadend = () => {
                const base64String = reader.result
                    .replace('data:', '')
                    .replace(/^.+,/, '');
                resolve(base64String);
            };
            reader.onerror = reject;
            reader.readAsDataURL(blob);
        });
    }

    // Audio conversion to match OpenAI's requirements
    async function convertAudio(audioBlob) {
        const audioContext = new AudioContext();
        const audioData = await audioBlob.arrayBuffer();
        const audioBuffer = await audioContext.decodeAudioData(audioData);

        const offlineContext = new OfflineAudioContext(
            1, // mono
            audioBuffer.duration * 16000, // target sample rate
            16000 // target sample rate
        );

        const source = offlineContext.createBufferSource();
        source.buffer = audioBuffer;
        source.connect(offlineContext.destination);
        source.start();

        const renderedBuffer = await offlineContext.startRendering();

        // Convert to 16-bit PCM WAV
        const length = renderedBuffer.length * 2;
        const buffer = new ArrayBuffer(44 + length); // WAV header is 44 bytes
        const view = new DataView(buffer);

        // Write WAV header
        const writeString = (view, offset, string) => {
            for (let i = 0; i < string.length; i++) {
                view.setUint8(offset + i, string.charCodeAt(i));
            }
        };

        writeString(view, 0, 'RIFF');
        view.setUint32(4, 36 + length, true);
        writeString(view, 8, 'WAVE');
        writeString(view, 12, 'fmt ');
        view.setUint32(16, 16, true);
        view.setUint16(20, 1, true);
        view.setUint16(22, 1, true);
        view.setUint32(24, 16000, true);
        view.setUint32(28, 32000, true);
        view.setUint16(32, 2, true);
        view.setUint16(34, 16, true);
        writeString(view, 36, 'data');
        view.setUint32(40, length, true);

        // Write audio data
        const data = new Float32Array(renderedBuffer.getChannelData(0));
        let offset = 44;
        for (let i = 0; i < data.length; i++) {
            const sample = Math.max(-1, Math.min(1, data[i]));
            view.setInt16(offset, sample < 0 ? sample * 0x8000 : sample * 0x7FFF, true);
            offset += 2;
        }

        return new Blob([buffer], { type: 'audio/wav' });
    }

    // Set up event listeners
    startButton.addEventListener('click', startRecording);
    stopButton.addEventListener('click', stopRecording);
    sendButton.addEventListener('click', sendRecording);

    // Initialize the session when the page loads
    initializeSession();
</script>
{{ end }}