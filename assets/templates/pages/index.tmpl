{{define "page:main"}}
{{ if .User }}
<main class="container">
    <h1>Resume Upload</h1>
    <form hx-post="/upload" hx-encoding="multipart/form-data" hx-target="body" hx-indicator="#loading-spinner"
        class="container">
        <input type="hidden" name="csrf_token" value="{{ .CSRFToken }}">
        <input type="hidden" id="session_id" name="session_id" value="{{ .SessionID }}">
        <div class="grid">
            <label for="phone">
                Phone Number
                <input type="tel" id="phone" name="phone" placeholder="+1 (555) 555-5555" pattern="^\+?1?\d{10,}$"
                    required>
            </label>
            <label for="resume">
                Resume (PDF or DOCX)
                <input type="file" id="resume" name="resume" accept=".pdf,.docx" required>
            </label>
        </div>
        <button type="submit">Upload Resume</button>
    </form>
    <img id="loading-spinner" class="htmx-indicator" src="/static/img/puff.svg">
    <div id="result"></div>
    <h1>Session: {{ .SessionID }}</h1>
    <h3>User: {{ .User }}</h3>
    <script>
        console.log("starting to watch for status updates on session {{ .SessionID }}");
        const es = new EventSource("/call/status/{{ .SessionID }}");

        es.onopen = () => {
            console.log("Connected to the server");
        };

        es.onmessage = (event) => {
            console.log(`Received: ${event.data}`);
        };

        es.onerror = (err) => {
            console.error("SSE Error:", err);
            es.close();
        };
    </script>
</main>
{{ else }}
{{template "partial:login" .}}
{{ end }}
{{end}}

{{ define "ResumeAnalysis" }}
<article>
    <h3>Resume Analysis</h3>
    <pre><code>{{ .YAML }}</code></pre>
</article>
{{ end }}

{{ define "UploadError" }}
<article class="error">
    <header>Error</header>
    <p>{{ .Message }}</p>
</article>
{{ end }}