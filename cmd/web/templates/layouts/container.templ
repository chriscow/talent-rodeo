package layouts

import (
    "fmt"
    "talent-rodeo/cmd/web/templates/partials"
    "talent-rodeo/internal/database"
)

templ head(title string) {
    <head>
        <title>{ title }</title>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="color-scheme" content="light dark" />

        <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.sand.min.css"
        >
        
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css">
        <link rel='stylesheet' href='/static/css/main.css'>
    </head>
    <script src="https://unpkg.com/htmx.org@2.0.4/dist/htmx.js" integrity="sha384-oeUn82QNXPuVkGCkcrInrS1twIxKhkZiFfr2TdiuObZ3n3yIeMiqcRzkIcguaof1" crossorigin="anonymous"></script>
    <script src="https://unpkg.com/htmx-ext-sse@2.2.2/sse.js"></script>

    <script src="https://js.pusher.com/8.2.0/pusher.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js"></script>
    <script src="https://unpkg.com/feather-icons"></script>
    <script src="/static/js/modal.js"></script>    
}

templ scripts() {
    <script>

        htmx.logger = function(elt, event, data) { if(console) console.log(event, elt, data)}

        var notyf = new Notyf();
        document.body.addEventListener('htmx:responseError', function(event) {
            var errorMessage;
            try {
                errorMessage = JSON.parse(event.detail.xhr.responseText).error;
            } catch (error) {
                errorMessage = event.detail.error;
            }
            notyf.error(`${errorMessage}`);

            console.log('-------------------')
            console.log("event:", event)
            console.log('-------------------')
        })

        feather.replace()  // feather icons
    </script>

    <script src="/static/js/minimal-theme-switcher.js"></script>    
}

templ ContainerWithCSRF(title, csrfToken string, user *database.User) {
    <!DOCTYPE html>
    <html lang="en">
    @head(title)

    @templ.Raw(fmt.Sprintf("<body hx-headers='{\"X-CSRF-Token\": \"%s\"}' >", csrfToken))
    <main class="container">
        @partials.Nav(user)
        { children... }
        @partials.Footer()
    </main>
    @templ.Raw("</body>")

    @scripts()
    </html>
}

templ Container(title string, user *database.User) {
    <!DOCTYPE html>
    <html lang="en">
    @head(title)

    <body>
    <main class="container">
        @partials.Nav(user)
        { children... }
        @partials.Footer()
    </main>
    </body>

    @scripts()
    </html>
}
