package pages

import (
	"talent-rodeo/cmd/web/components/layouts"
	"talent-rodeo/cmd/web/components/partials"
	"talent-rodeo/internal/database"
)

templ Resume(csrfToken, sessionID string, user *database.User) {
	@layouts.ContainerWithCSRF("home", csrfToken, user) {
		<main class="container">
			<h1>Resume Upload</h1>
			@partials.ResumeUploadForm(csrfToken, sessionID)
		</main>
	}
}
