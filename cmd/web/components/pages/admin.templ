package pages

import (
	"talent-rodeo/cmd/web/components/layouts"
	"talent-rodeo/internal/database"
)

templ Admin(csrfToken string, user *database.User, users []database.User) {
	@layouts.ContainerWithCSRF("admin", csrfToken, user) {
		<h1>Welcome, { user.FirstName }</h1>
		<p>Here are the users:</p>
		<ul>
			for _, u := range users {
				<li>{ u.Name }</li>
			}
		</ul>
	}
}
